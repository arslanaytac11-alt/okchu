{
  "name": "okchu",
  "version": "1.1.1",
  "description": "Okchu: Arrow Puzzle \u2014 10 ancient civilizations, 50 levels",
  "private": true,
  "scripts": {
    "preview": "node preview-server.mjs",
    "preview:start": "node start-preview.mjs",
    "build": "node build-www.mjs",
    "cap:sync": "node build-www.mjs && npx cap sync ios",
    "cap:add-ios": "node build-www.mjs && npx cap add ios",
    "cap:open": "npx cap open ios",
    "cap:copy": "node build-www.mjs && npx cap copy ios",
    "test": "node tests/run-checks.mjs",
    "postinstall": "node ios/scripts/prepare-capacitor-cli.cjs",
    "levels:generate": "node generate-balanced-puzzles.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "cordova-plugin-purchase": "^13.15.2"
  },
  "type": "module",
  "overrides": {
    "tar": "7.5.22"
  }
}
